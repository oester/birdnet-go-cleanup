[Unit]
Description=BirdNET-Go DB cleanup web tool
After=network.target

[Service]
Type=simple
User=oester
WorkingDirectory=/home/oester/birdnet-cleanup-tool
Environment=PORT=5055
Environment=BIRDNET_BASE_URL=http://localhost:8080/api/v2
ExecStart=/home/oester/birdnet-cleanup-tool/venv/bin/python /home/oester/birdnet-cleanup-tool/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
